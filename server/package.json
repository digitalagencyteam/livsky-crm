{
  "name": "livsky-crm-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --experimental-test-module-mocks --test \"src/**/__tests__/*.test.js\" \"../shared/__tests__/*.test.js\"",
    "seed:admin": "node src/scripts/seedAdmin.js",
