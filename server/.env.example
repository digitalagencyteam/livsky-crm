# ---- База ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/livsky_crm
PORT=4000

# ---- Секреты входа (на боевом сервере обязательны: openssl rand -hex 32) ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---- Адреса ----
# Админка (CORS)
CLIENT_URL=http://localhost:5173
# Сайт: откуда браузер может слать заявки (через запятую)
SITE_ORIGINS=http://localhost:3000,https://livsky.ru
# Публичный адрес этого API — для ссылок на картинки при локальном хранении
PUBLIC_URL=http://localhost:4000

# ---- Сайт обновляется после публикации ----
# Next на сервере: https://livsky.ru/api/revalidate ; статика: deploy hook хостинга. Через запятую.
SITE_HOOKS=
# Тот же секрет, что REVALIDATE_SECRET у сайта
SITE_HOOK_SECRET=

# ---- Админ (для npm run seed:admin) ----
ADMIN_EMAIL=agencyworkemailone@gmail.com
ADMIN_PASSWORD=Livsky2026!

# ---- Почта: коды восстановления и уведомления о заявках ----
# Gmail: включите 2FA и создайте «пароль приложения» (myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=agencyworkemailone@gmail.com
SMTP_PASS=
SMTP_FROM=LIVSKY CRM <agencyworkemailone@gmail.com>
# Куда слать заявки с сайта
NOTIFY_EMAIL=agencyworkemailone@gmail.com

# ---- Telegram (необязательно): заявки сообщением ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Файлы: Cloudflare R2. Пусто — папка uploads/ (только для разработки: на Render диск стирается) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Публичный домен бакета для картинок и видео сайта, например https://media.livsky.ru
R2_PUBLIC_URL=
